; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Taos Game Maker"
run/main_scene="res://scenes/ui/splash/SplashScreen.tscn"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0.04, 0.05, 0.08, 1)
boot_splash/image="res://assets/common/boot_splash.png"
config/icon="res://icon.png"

[autoload]

Locale="*res://scripts/autoload/Locale.gd"
Design="*res://scripts/autoload/Design.gd"
ExplorationSkills="*res://scripts/autoload/ExplorationSkills.gd"
GlobalState="*res://scripts/autoload/GlobalState.gd"
GlobalEvents="*res://scripts/autoload/GlobalEvents.gd"
SaveManager="*res://scripts/autoload/SaveManager.gd"
TimeManager="*res://scripts/autoload/TimeManager.gd"
QuestManager="*res://scripts/autoload/QuestManager.gd"
SceneRunner="*res://scripts/autoload/SceneRunner.gd"
NarrativeOverlay="*res://scenes/components/narrative/NarrativeOverlay.gd"
SceneManager="*res://scripts/autoload/SceneManager.gd"
AudioManager="*res://scripts/autoload/AudioManager.gd"
MetaManager="*res://scripts/autoload/MetaManager.gd"
Juice="*res://scripts/autoload/Juice.gd"
OrbBarksManager="*res://scripts/systems/OrbBarksManager.gd"
OrbCompanionManager="*res://scripts/systems/OrbCompanionManager.gd"
OrbCompanionOverlay="*res://scenes/components/orb_companion/OrbCompanionOverlay.gd"

[display]

window/size/viewport_width=2340
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=590
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/default_font_size=20

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=1024
rendering_device/driver.mac="metal"
