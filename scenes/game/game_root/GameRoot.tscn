grow_vertical = 2
text = "100/100"
horizontal_alignment = 1
vertical_alignment = 1
theme_override_font_sizes/font_size = 34

[node name="BarMP" type="ProgressBar" parent="VBoxMain/PanelHUD/MarginHUD/HBoxMainHUD/VBoxStats"]
custom_minimum_size = Vector2(0, 62)
layout_mode = 2
theme_override_styles/background = SubResource("StyleBoxFlat_bar_bg")
theme_override_styles/fill = SubResource("StyleBoxFlat_mp_fill")
value = 50.0
show_percentage = false

[node name="LblMP" type="Label" parent="VBoxMain/PanelHUD/MarginHUD/HBoxMainHUD/VBoxStats/BarMP"]
layout_mode = 1
anchors_preset = 15
