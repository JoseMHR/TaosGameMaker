; ─────────────────────────────────────────────────────────────────────────────
; GameRoot — Contenedor principal del juego
; Estructura: VBoxMain (HUD | ViewStack expandible | TabBar)
; Las vistas se instancian dinámicamente en GameRoot.gd
; ─────────────────────────────────────────────────────────────────────────────
[node name="GameRoot" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_gr")

; ─── Fondo ───────────────────────────────────────────────────────────────────
[node name="BG" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.04, 0.03, 0.06, 1.0)

; ─── Layout principal ────────────────────────────────────────────────────────
[node name="VBoxMain" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 0

; ════════════════════════════════════════════════════════════════════════════
; HUD SUPERIOR
; ════════════════════════════════════════════════════════════════════════════
[node name="PanelHUD" type="PanelContainer" parent="VBoxMain"]
layout_mode = 2
custom_minimum_size = Vector2(0, 190)

[node name="MarginHUD" type="MarginContainer" parent="VBoxMain/PanelHUD"]
layout_mode = 2
theme_override_constants/margin_left = 14
theme_override_constants/margin_right = 14
theme_override_constants/margin_top = 10
theme_override_constants/margin_bottom = 10

[node name="HBoxMainHUD" type="HBoxContainer" parent="VBoxMain/PanelHUD/MarginHUD"]
layout_mode = 2
theme_override_constants/separation = 10

; ── IZQUIERDA: info del héroe (el avatar se añade por código en index 0) ──
[node name="VBoxLeft" type="VBoxContainer" parent="VBoxMain/PanelHUD/MarginHUD/HBoxMainHUD"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 4
alignment = 1

[node name="HBoxBaseLevel" type="HBoxContainer" parent="VBoxMain/PanelHUD/MarginHUD/HBoxMainHUD/VBoxLeft"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="LblLevel" type="Label" parent="VBoxMain/PanelHUD/MarginHUD/HBoxMainHUD/VBoxLeft/HBoxBaseLevel"]
layout_mode = 2
text = "LVL 1"
theme_override_colors/font_color = Color(0.97, 0.78, 0.26, 1)
theme_override_font_sizes/font_size = 34
vertical_alignment = 1

[node name="LblBaseLevelName" type="Label" parent="VBoxMain/PanelHUD/MarginHUD/HBoxMainHUD/VBoxLeft/HBoxBaseLevel"]
layout_mode = 2
text = "Base"
theme_override_colors/font_color = Color(0.65, 0.65, 0.7, 1)
theme_override_font_sizes/font_size = 26
vertical_alignment = 1

[node name="BarXP" type="ProgressBar" parent="VBoxMain/PanelHUD/MarginHUD/HBoxMainHUD/VBoxLeft"]
custom_minimum_size = Vector2(0, 24)
layout_mode = 2
value = 50.0
show_percentage = false

[node name="HBoxJobLevel" type="HBoxContainer" parent="VBoxMain/PanelHUD/MarginHUD/HBoxMainHUD/VBoxLeft"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="LblJobLevel" type="Label" parent="VBoxMain/PanelHUD/MarginHUD/HBoxMainHUD/VBoxLeft/HBoxJobLevel"]
layout_mode = 2
text = "JOB 1"
theme_override_colors/font_color = Color(0.85, 0.65, 0.95, 1)
theme_override_font_sizes/font_size = 34
vertical_alignment = 1

[node name="LblClass" type="Label" parent="VBoxMain/PanelHUD/MarginHUD/HBoxMainHUD/VBoxLeft/HBoxJobLevel"]
layout_mode = 2
text = "Ninguna"
theme_override_colors/font_color = Color(0.6, 0.65, 0.85, 1)
theme_override_font_sizes/font_size = 26
vertical_alignment = 1

[node name="BarJobXP" type="ProgressBar" parent="VBoxMain/PanelHUD/MarginHUD/HBoxMainHUD/VBoxLeft"]
custom_minimum_size = Vector2(0, 24)
layout_mode = 2
value = 50.0
show_percentage = false

; ── DERECHA: columna de estadísticas (barras HP/MP/EN), expandida ──
[node name="VBoxStats" type="VBoxContainer" parent="VBoxMain/PanelHUD/MarginHUD/HBoxMainHUD"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 6
alignment = 1

[node name="BarHP" type="ProgressBar" parent="VBoxMain/PanelHUD/MarginHUD/HBoxMainHUD/VBoxStats"]
custom_minimum_size = Vector2(0, 62)
layout_mode = 2
theme_override_styles/background = SubResource("StyleBoxFlat_bar_bg")
theme_override_styles/fill = SubResource("StyleBoxFlat_hp_fill")
