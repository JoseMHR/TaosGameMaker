; ════════════════════════════════════════════════════════════════════════════
; VIEW STACK — Las vistas se añaden aquí por código en _ready()
; ════════════════════════════════════════════════════════════════════════════
[node name="ViewStack" type="Control" parent="VBoxMain"]
layout_mode = 2
size_flags_vertical = 3
clip_contents = true

; ════════════════════════════════════════════════════════════════════════════
; TAB BAR INFERIOR
; ════════════════════════════════════════════════════════════════════════════
[node name="PanelTabBar" type="PanelContainer" parent="VBoxMain"]
layout_mode = 2
custom_minimum_size = Vector2(0, 150)

[node name="HBoxTabs" type="HBoxContainer" parent="VBoxMain/PanelTabBar"]
layout_mode = 2
alignment = 1
theme_override_constants/separation = 6

[node name="BtnWorld" type="Button" parent="VBoxMain/PanelTabBar/HBoxTabs"]
layout_mode = 2
size_flags_horizontal = 3
text = "🗺️\nMundo"
theme_override_font_sizes/font_size = 38
theme_override_colors/font_color = Color(0.97, 0.78, 0.26, 1.0)

[node name="BtnCharacter" type="Button" parent="VBoxMain/PanelTabBar/HBoxTabs"]
layout_mode = 2
size_flags_horizontal = 3
text = "👤\nPersonaje"
theme_override_font_sizes/font_size = 38
theme_override_colors/font_color = Color(0.45, 0.45, 0.50, 1.0)

[node name="BtnBag" type="Button" parent="VBoxMain/PanelTabBar/HBoxTabs"]
layout_mode = 2
size_flags_horizontal = 3
text = "🎒\nBolsa"
theme_override_font_sizes/font_size = 38
theme_override_colors/font_color = Color(0.45, 0.45, 0.50, 1.0)

[node name="BtnInfo" type="Button" parent="VBoxMain/PanelTabBar/HBoxTabs"]
layout_mode = 2
size_flags_horizontal = 3
text = "ℹ️\nInfo"
theme_override_font_sizes/font_size = 38
theme_override_colors/font_color = Color(0.45, 0.45, 0.50, 1.0)

[node name="BtnOptions" type="Button" parent="VBoxMain/PanelTabBar/HBoxTabs"]
layout_mode = 2
size_flags_horizontal = 3
