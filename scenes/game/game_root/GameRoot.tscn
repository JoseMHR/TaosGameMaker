[node name="BarEN" type="ProgressBar" parent="VBoxMain/PanelHUD/MarginHUD/HBoxMainHUD/VBoxStats"]
custom_minimum_size = Vector2(0, 32)
layout_mode = 2
theme_override_styles/background = SubResource("StyleBoxFlat_bar_bg")
theme_override_styles/fill = SubResource("StyleBoxFlat_en_fill")
value = 100.0
