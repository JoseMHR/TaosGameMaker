theme_override_colors/font_color = Color(0.45, 0.45, 0.50, 1.0)

; ═════════════════════════════════════════════════════════════════════════════
; OVERLAY "PRÓXIMAMENTE" — pantalla placeholder para tabs no implementados
; ═════════════════════════════════════════════════════════════════════════════
[node name="ComingSoonOverlay" type="PanelContainer" parent="."]
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBoxCS" type="VBoxContainer" parent="ComingSoonOverlay"]
layout_mode = 2
alignment = 1
theme_override_constants/separation = 24

[node name="LblCSEmoji" type="Label" parent="ComingSoonOverlay/VBoxCS"]
layout_mode = 2
text = "🚧"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 90

[node name="LblCSTitle" type="Label" parent="ComingSoonOverlay/VBoxCS"]
layout_mode = 2
text = "Próximamente"
horizontal_alignment = 1
autowrap_mode = 3
theme_override_font_sizes/font_size = 28
theme_override_colors/font_color = Color(0.80, 0.80, 0.85, 1.0)

[node name="BtnCloseCS" type="Button" parent="ComingSoonOverlay/VBoxCS"]
layout_mode = 2
size_flags_horizontal = 4
custom_minimum_size = Vector2(320, 72)
text = "← Volver al Mapa"
theme_override_font_sizes/font_size = 27

; ─── Timer de regeneración pasiva (3 segundos) ───────────────────────────────
[node name="PassiveTimer" type="Timer" parent="."]
wait_time = 1.0
one_shot = false
autostart = true

[connection signal="timeout" from="PassiveTimer"                    to="." method="_on_passive_timer_timeout"]
[connection signal="pressed" from="ComingSoonOverlay/VBoxCS/BtnCloseCS" to="." method="_on_btn_close_cs_pressed"]
