# Godot 4+ specific ignores
.godot/
*.translation

# Android build template & binaries
android/build/
*.apk
*.aab
*.aar
local.properties

# Android keystores (Never commit private keys!)
*.keystore
*.jks

# Python cache (tools, editor/serve.py)
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Node cache (tools/check_editor.mjs)
node_modules/
package-lock.json

# OS files & caches
.DS_Store
Thumbs.db
Desktop.ini
*.tmp
*.temp

# Heavy distribution exports & binaries (published via GitHub Releases)
dist/engine/
dist/game_echoes_of_truth/
*.zip
*.mp4

# IDE / Editor config
.idea/
.vscode/
*.swp
*.bak
